{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>t-seki/renovate-config"],
  "ignorePaths": [
    ".github/workflows/release.yml"
  ],
  "packageRules": [
    {
      "description": "全依存を chore(deps): に固定。runtime 依存の fix(deps): が自動マージされて release-please のリリースが毎週走るのを防ぐ",
      "matchPackageNames": ["*"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "tokio family",
      "groupName": "tokio",
      "matchPackageNames": ["tokio", "tokio-*"]
    },
    {
      "description": "serde family",
      "groupName": "serde",
      "matchPackageNames": ["serde", "serde_json", "serde_derive"]
    },
    {
      "description": "clap family",
      "groupName": "clap",
      "matchPackageNames": ["clap", "clap_*"]
    },
    {
      "description": "HTTP / scraping crates",
      "groupName": "http-stack",
      "matchPackageNames": ["reqwest", "scraper"]
    },
    {
      "description": "Error handling crates",
      "groupName": "error-handling",
      "matchPackageNames": ["anyhow", "thiserror"]
    },
    {
      "description": "Terminal UI crates",
      "groupName": "terminal-ui",
      "matchPackageNames": ["colored", "indicatif"]
    },
    {
      "description": "ci.yml の msrv job の toolchain は Cargo.toml の rust-version と同じ値に固定する。Renovate の actions manager は dtolnay/rust-toolchain の with.toolchain を rust の版(depType uses-with)として更新してしまう。action の digest(depType action)は別の dep なので止まらない",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["rust"],
      "enabled": false
    },
    {
      "description": "GitHub Actions",
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    }
  ]
}
